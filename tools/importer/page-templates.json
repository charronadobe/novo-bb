        },
        {
          "id": "section-4",
          "name": "Getting help steps",
          "selector": [
            "section.section-container:has(> .cmp-container > .splitlayout .cmp-card)"
          ],
          "style": "light-grey, centered",
          "blocks": [
            "cards-photo-cta"
          ],
          "defaultContent": [
            "section.section-container:has(> .cmp-container > .splitlayout .cmp-card) > .cmp-container > .title"
          ]
        },
        {
          "id": "section-5",
          "name": "Obesity stats",
